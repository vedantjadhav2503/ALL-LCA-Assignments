   "source": [
    "# PAN Number Validation\n",
    "\n",
    "pan = input(\"Enter PAN Number: \")\n",
    "\n",
    "if (len(pan) == 10 and\n",
    "    pan[0:5].isalpha() and pan[0:5].isupper() and\n",
    "    pan[5:9].isdigit() and\n",
    "    pan[9].isalpha() and pan[9].isupper()):\n",
    "    \n",
    "    print(\"Valid PAN Number\")\n",
    "else:\n",
    "    print(\"Invalid PAN Number\")"
   ]
  },
